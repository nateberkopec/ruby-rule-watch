{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "ruby-moderation-noti",
  "blocks": {
    "entry": "src/main.ts",
    "triggers": [
      "onPostSubmit",
      "onPostCreate",
      "onPostUpdate",
      "onCommentSubmit",
      "onCommentCreate",
      "onCommentUpdate",
      "onModAction",
      "onAppInstall",
      "onAppUpgrade"
    ]
  },
  "scheduler": {
    "tasks": {}
  },
  "permissions": {
    "reddit": true,
    "redis": true,
    "http": {
      "enable": true,
      "domains": [
        "api.openai.com"
      ]
    }
  },
  "dev": {
    "subreddit": "ruby_moderation_n_dev"
  },
  "post": {
    "dir": "public",
    "entrypoints": {
      "default": {
        "entry": "launch.html",
        "height": "regular"
      },
      "backtest": {
        "entry": "index.html",
        "height": "tall"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "scripts": {
    "build": "npm run build:backtest"
  }
}
